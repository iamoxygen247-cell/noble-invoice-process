__pycache__/
*.py[cod]
.venv/
functionapp/local.settings.json
output/
samples/
# Regression corpus: the invoice PDFs stay local-only, like samples/. The
# expectation sidecars are tracked so the corpus assertions are reviewable and
# shared; note they embed real service addresses / account numbers.
# (Ignore the directory *contents*, not the directory, or the negation below
# would never be reached -- git does not descend into an excluded directory.)
tests/pre-commit-test/*
!tests/pre-commit-test/*.expected.json
*.key
.DS_Store
Thumbs.db
.code-workspace
out/
CLAUDE.local.md
.claude/settings.local.json
# Single-developer repo: the Claude permission allowlist is machine-local, not shared.
# It accumulated session-scoped temp paths and machine paths twice (108cb9a, e794864);
# untracked 2026-08-19 so it stops re-entering history.
.claude/settings.json

# Azurite local emulator artifacts
__azurite_db*.json
__blobstorage__/
__queuestorage__/
AzuriteConfig


# Local-only documents. Anything in docs/gitignore/ stays on this machine: working
# plans, drafts, one-off analyses -- deliverables that are useful now but should not
# enter history. Tracked docs continue to live directly under docs/ and docs/ai/.
# (The folder itself is not tracked, so a fresh clone will not have it; create it with
#  mkdir docs/gitignore when you need it.)
docs/gitignore/
